---
// Decorative, illustrative launch profile for the home hero. Not real flight data.
const TRAJ = 'M70 440 C 110 250, 205 118, 300 110 S 425 210, 452 352';
const ORBIT = 'M262 92 A 112 30 -12 1 1 470 48 A 112 30 -12 1 1 262 92';
const markers = [
  { x: 108, y: 316, label: 'MAX-Q', d: '0.9s' },
  { x: 196, y: 158, label: 'MECO', d: '1.8s' },
  { x: 300, y: 110, label: 'APOGEE', d: '2.9s' },
];
---

<figure class="flight bp corners relative overflow-hidden rounded-xl shadow-[0_30px_70px_-35px_rgb(0_0_0/0.6)]" data-flight>
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5 font-mono text-[0.62rem] tracking-[0.14em] uppercase opacity-75">
    <span>Fig. 0 · Flight profile</span>
    <button type="button" class="replay inline-flex items-center gap-1.5 uppercase transition-opacity hover:opacity-100" aria-label="Replay the flight animation">
      ↻ Replay
    </button>
  </div>

  <svg viewBox="0 0 480 470" class="block w-full" fill="none" stroke="currentColor" font-family="IBM Plex Mono, monospace" aria-hidden="true">
    <!-- Earth limb -->
    <path d="M-20 462 Q240 420 500 462 L500 480 L-20 480Z" fill="rgb(255 255 255 / 0.06)" stroke="none" />
    <path d="M-20 462 Q240 420 500 462" stroke-width="1.2" opacity="0.55" />

    <!-- Altitude axis -->
    <path d="M44 446 V40" stroke-width="1" opacity="0.5" />
    {
      [0, 1, 2, 3, 4, 5].map((i) => (
        <g opacity="0.6">
          <path d={`M40 ${446 - i * 76} h8`} stroke-width="1" />
          <text x="34" y={446 - i * 76 + 3} text-anchor="end" font-size="9" fill="currentColor" stroke="none">{i * 20}</text>
        </g>
      ))
    }
    <text x="34" y="26" text-anchor="end" font-size="8.5" fill="currentColor" stroke="none" opacity="0.6">ALT km</text>

    <!-- Predicted trajectory (dashed, static) -->
    <path d="M70 440 C 116 262, 214 124, 312 120 S 436 222, 462 352" stroke-dasharray="3 6" stroke-width="1" opacity="0.45" />

    <!-- Flown trajectory (draws itself) -->
    <path class="traj" d={TRAJ} pathLength="1" stroke="var(--accent-bright)" stroke-width="2.4" stroke-linecap="round" />

    <!-- Event markers -->
    {
      markers.map((m) => (
        <g class="marker" style={`--d:${m.d}`}>
          <path d={`M${m.x} ${m.y - 6} l6 6 -6 6 -6 -6z`} fill="var(--bp)" stroke="currentColor" stroke-width="1.2" />
          <path d={`M${m.x + 9} ${m.y - 4} l14 -14 h34`} stroke-width="0.8" opacity="0.7" />
          <text x={m.x + 25} y={m.y - 22} font-size="9.5" fill="currentColor" stroke="none" letter-spacing="1">{m.label}</text>
        </g>
      ))
    }
    <path class="marker" style="--d:2.9s" d="M300 118 V446" stroke-dasharray="2 4" stroke-width="0.8" opacity="0.6" />

    <!-- Orbit with satellite -->
    <path d={ORBIT} stroke-width="1" stroke-dasharray="1 5" opacity="0.7" />
    <g>
      <rect x="-4" y="-2.5" width="8" height="5" fill="currentColor" stroke="none" />
      <path d="M-11 0 h5 M6 0 h5" stroke-width="2.4" />
      <animateMotion dur="11s" repeatCount="indefinite" path={ORBIT} />
    </g>

    <!-- Launch pad -->
    <path d="M58 446 h24 M64 446 v-10 M76 446 v-10" stroke-width="1.2" />

    <!-- Rocket riding the trajectory -->
    <g class="rocket">
      <path d="M12 0 L2 -4 H-10 L-13 -7 V7 L-10 4 H2 Z" fill="var(--bp-ink)" stroke="none" />
      <path d="M-13 -2 L-22 0 L-13 2" fill="var(--accent-bright)" stroke="none" class="flame" />
      <animateMotion
        dur="3.2s"
        begin="0.2s"
        fill="freeze"
        rotate="auto"
        path={TRAJ}
        calcMode="spline"
        keyPoints="0;1"
        keyTimes="0;1"
        keySplines="0.35 0 0.2 1"
      />
    </g>
  </svg>

  <!-- Telemetry readout -->
  <figcaption class="grid grid-cols-4 border-t border-white/10 font-mono text-[0.62rem] tracking-[0.1em] uppercase">
    <span class="border-r border-white/10 px-3 py-2.5"><span class="block opacity-60">T+</span><b class="font-medium" data-t>00:00</b></span>
    <span class="border-r border-white/10 px-3 py-2.5"><span class="block opacity-60">Alt km</span><b class="font-medium" data-alt>000.0</b></span>
    <span class="border-r border-white/10 px-3 py-2.5"><span class="block opacity-60">Vel m/s</span><b class="font-medium" data-vel>0000</b></span>
    <span class="px-3 py-2.5"><span class="block opacity-60">Status</span><b class="font-medium text-[#7ee2a8]" data-status>GO</b></span>
  </figcaption>
  <p class="sr-only">Illustrative animation of a rocket launch trajectory. Not real flight data.</p>
</figure>

<style>
  .flight .traj {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .flight.fly .traj {
    animation: draw 3.2s cubic-bezier(0.35, 0, 0.2, 1) 0.2s both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  .flight.fly .marker {
    animation: pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .flight .marker {
    transform-box: fill-box;
  }
  .flame {
    animation: flicker 0.12s steps(2) infinite;
    transform-box: fill-box;
    transform-origin: 100% 50%;
  }
  @keyframes flicker {
    50% {
      transform: scaleX(0.6);
    }
  }
  .flight.landed .flame {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .flight.fly .traj,
    .flight.fly .marker,
    .flame {
      animation: none !important;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-flight]').forEach((fig) => {
    const svg = fig.querySelector('svg')!;
    const t = fig.querySelector<HTMLElement>('[data-t]')!;
    const alt = fig.querySelector<HTMLElement>('[data-alt]')!;
    const vel = fig.querySelector<HTMLElement>('[data-vel]')!;
    const status = fig.querySelector<HTMLElement>('[data-status]')!;
    let raf = 0;

    const ease = (x: number) => 1 - Math.pow(1 - x, 2.4);
    function telemetry() {
      cancelAnimationFrame(raf);
      const start = performance.now();
      const loop = (now: number) => {
        const s = (now - start) / 1000;
        const p = Math.min(1, Math.max(0, (s - 0.2) / 3.2)); // flight progress
        const ascent = Math.min(1, p / 0.62);
        alt.textContent = (p < 0.62 ? ease(ascent) * 88.4 : 88.4 - ((p - 0.62) / 0.38) ** 2 * 63).toFixed(1).padStart(5, '0');
        const v = p < 0.3 ? (p / 0.3) * 1650 : 1650 - ((p - 0.3) / 0.7) * 830;
        vel.textContent = String(Math.round(v)).padStart(4, '0');
        const secs = Math.floor(s * 18); // sped-up mission clock
        t.textContent = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
        status.textContent = p < 0.3 ? 'BOOST' : p < 0.62 ? 'COAST' : p < 1 ? 'DESCENT' : 'NOMINAL';
        if (p < 1) raf = requestAnimationFrame(loop);
        else fig.classList.add('landed');
      };
      raf = requestAnimationFrame(loop);
    }

    function play() {
      fig.classList.remove('fly', 'landed');
      void fig.offsetWidth; // restart CSS animations
      fig.classList.add('fly');
      svg.setCurrentTime(0);
      telemetry();
    }

    if (reduce) {
      svg.setCurrentTime(3.5);
      svg.pauseAnimations();
      fig.classList.add('landed');
      alt.textContent = '025.4';
      status.textContent = 'NOMINAL';
    } else {
      play();
    }
    fig.querySelector('.replay')!.addEventListener('click', play);
  });
</script>
