---
// Interactive model-rocket launch simulator (simplified physics in src/lib/rocket.ts).
// Server-renders a default flight so it looks right without JavaScript.
import { MOTORS, simulate, layout, layersSVG } from '../lib/rocket';

interface Props {
  defaultMotor?: string;
  defaultAngle?: number;
  title?: string;
}
const { defaultMotor = 'D12', defaultAngle = 80, title = 'Launch sim' } = Astro.props;
const flight = simulate(defaultMotor, defaultAngle);
const L = layout(flight);
const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
---

<figure class="flight bp corners relative overflow-hidden rounded-xl shadow-[0_30px_70px_-35px_rgb(0_0_0/0.55)]" data-flight data-motor={defaultMotor} data-angle={defaultAngle}>
  <div class="flex items-center justify-between border-b border-white/15 px-4 py-2.5 font-mono text-[0.62rem] tracking-[0.14em] uppercase">
    <span class="opacity-80">Fig. 0 · {title}</span>
    <span class="flex items-center gap-1.5 opacity-80"><span class="size-1.5 rounded-full bg-[#7ee2a8]"></span>Interactive</span>
  </div>

  <svg viewBox="0 0 480 452" class="block w-full touch-none" fill="none" stroke="currentColor" font-family="IBM Plex Mono, monospace" aria-hidden="true">
    <g class="layers" set:html={layersSVG(flight)} />
    <path class="traj" d={L.path()} stroke="var(--accent-bright)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <g class="rocket" style="opacity:0">
      <path d="M12 0 L2 -4 H-10 L-13 -7 V7 L-10 4 H2 Z" fill="var(--bp-ink)" stroke="none" />
      <path class="flame" d="M-13 -2 L-23 0 L-13 2" fill="var(--accent-bright)" stroke="none" />
    </g>
  </svg>

  <!-- Live telemetry -->
  <div class="grid grid-cols-4 border-t border-white/15 font-mono text-[0.62rem] tracking-[0.1em] uppercase" aria-live="polite">
    <span class="border-r border-white/15 px-3 py-2.5"><span class="block opacity-65">T+ s</span><b class="font-medium" data-t>{flight.time.toFixed(1)}</b></span>
    <span class="border-r border-white/15 px-3 py-2.5"><span class="block opacity-65">Apogee m</span><b class="font-medium" data-alt>{fmt(flight.apogee)}</b></span>
    <span class="border-r border-white/15 px-3 py-2.5"><span class="block opacity-65">Vel m/s</span><b class="font-medium" data-vel>{fmt(flight.maxV)}</b></span>
    <span class="px-3 py-2.5"><span class="block opacity-65">Status</span><b class="font-medium text-[#7ee2a8]" data-status>Landed</b></span>
  </div>

  <!-- Controls -->
  <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 border-t border-white/15 bg-black/15 px-4 py-3.5">
    <div class="flex items-center gap-2" role="radiogroup" aria-label="Motor">
      <span class="hidden w-[2.6rem] font-mono text-[0.6rem] tracking-[0.12em] uppercase opacity-70 sm:inline">Motor</span>
      <div class="flex overflow-hidden rounded-sm border border-white/25">
        {
          MOTORS.map((m) => (
            <button
              type="button"
              role="radio"
              aria-checked={m.id === defaultMotor ? 'true' : 'false'}
              data-motor-btn={m.id}
              title={m.label}
              class="border-r border-white/20 px-2 py-1.5 font-mono text-[0.7rem] sm:px-2.5 font-medium transition-colors last:border-r-0 hover:bg-white/10 aria-checked:bg-[var(--accent-bright)] aria-checked:text-white"
            >
              {m.id}
            </button>
          ))
        }
      </div>
    </div>
    <button
      type="button"
      data-launch
      class="row-span-2 inline-flex h-full min-h-9 items-center justify-center gap-2 bg-[var(--accent-bright)] px-3 sm:px-5 font-mono text-[0.72rem] font-medium tracking-[0.12em] text-white uppercase transition-transform hover:-translate-y-0.5 active:translate-y-0"
    >
      ▲ Launch
    </button>
    <label class="flex items-center gap-2.5 font-mono text-[0.6rem] tracking-[0.12em] uppercase">
      <span class="w-[2.6rem] opacity-70">Angle</span>
      <input type="range" min="60" max="90" step="1" value={defaultAngle} data-angle-input class="min-w-0 flex-1 accent-[var(--accent-bright)]" aria-label="Launch angle in degrees" />
      <b class="w-8 text-right text-[0.72rem] font-medium" data-angle-out>{defaultAngle}°</b>
    </label>
  </div>
  <figcaption class="border-t border-white/10 px-4 py-2 font-mono text-[0.58rem] leading-relaxed tracking-[0.06em] opacity-60">
    Simplified 2-D model: average motor thrust, gravity, and drag on a 25 mm body. Parachute ignored.
  </figcaption>
</figure>

<style>
  .flight .mk {
    transition: opacity 0.4s;
  }
  .flight.flying .mk {
    opacity: 0;
  }
  .flight.flying .mk.shown {
    opacity: 1;
  }
  .flame {
    animation: flicker 0.12s steps(2) infinite;
    transform-box: fill-box;
    transform-origin: 100% 50%;
  }
  @keyframes flicker {
    50% {
      transform: scaleX(0.55);
    }
  }
  .flight:not(.burning) .flame {
    display: none;
  }
  input[type='range'] {
    height: 4px;
  }
</style>

<script>
  import { simulate, layout, layersSVG } from '../lib/rocket';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-flight]').forEach((fig) => {
    const layers = fig.querySelector<SVGGElement>('.layers')!;
    const traj = fig.querySelector<SVGPathElement>('.traj')!;
    const rocket = fig.querySelector<SVGGElement>('.rocket')!;
    const out = {
      t: fig.querySelector<HTMLElement>('[data-t]')!,
      alt: fig.querySelector<HTMLElement>('[data-alt]')!,
      vel: fig.querySelector<HTMLElement>('[data-vel]')!,
      status: fig.querySelector<HTMLElement>('[data-status]')!,
    };
    const angleIn = fig.querySelector<HTMLInputElement>('[data-angle-input]')!;
    const angleOut = fig.querySelector<HTMLElement>('[data-angle-out]')!;
    const motorBtns = fig.querySelectorAll<HTMLButtonElement>('[data-motor-btn]');
    let motor = fig.dataset.motor!;
    let raf = 0;

    function launch() {
      cancelAnimationFrame(raf);
      const f = simulate(motor, Number(angleIn.value));
      const L = layout(f);
      layers.innerHTML = layersSVG(f);
      const marks = [...layers.querySelectorAll<SVGElement>('.mk')];
      const burnT = f.points[f.burnoutIndex].t;
      const apT = f.points[f.apogeeIndex].t;

      if (reduce) {
        traj.setAttribute('d', L.path());
        rocket.style.opacity = '0';
        out.t.textContent = f.time.toFixed(1);
        out.alt.textContent = Math.round(f.apogee).toLocaleString('en-US');
        out.vel.textContent = Math.round(f.maxV).toLocaleString('en-US');
        out.status.textContent = 'Landed';
        return;
      }

      fig.classList.add('flying', 'burning');
      rocket.style.opacity = '1';
      const playSeconds = Math.min(4.2, Math.max(2.6, f.time / 6)); // speed up real flight time
      const start = performance.now();
      let peak = 0;

      const frame = (now: number) => {
        const simT = Math.min(f.time, ((now - start) / 1000 / playSeconds) * f.time);
        let i = f.points.findIndex((p) => p.t >= simT);
        if (i < 0) i = f.points.length - 1;
        const p = f.points[i];
        const prev = f.points[Math.max(0, i - 1)];
        traj.setAttribute('d', L.path(i + 1));
        const ang = (Math.atan2(-(p.y - prev.y), p.x - prev.x || 0.0001) * 180) / Math.PI;
        rocket.setAttribute('transform', `translate(${L.X(p.x).toFixed(1)} ${L.Y(p.y).toFixed(1)}) rotate(${i === 0 ? -Number(angleIn.value) : ang})`);
        peak = Math.max(peak, p.y);
        out.t.textContent = simT.toFixed(1);
        out.alt.textContent = Math.round(peak).toLocaleString('en-US');
        out.vel.textContent = Math.round(p.v).toLocaleString('en-US');
        out.status.textContent = simT < burnT ? 'Boost' : simT < apT ? 'Coast' : simT < f.time ? 'Descent' : 'Landed';
        fig.classList.toggle('burning', simT < burnT);
        if (simT >= burnT) marks.filter((m) => m.style.getPropertyValue('--d') === '0').forEach((m) => m.classList.add('shown'));
        if (simT >= apT) marks.filter((m) => m.style.getPropertyValue('--d') === '1').forEach((m) => m.classList.add('shown'));
        if (simT < f.time) raf = requestAnimationFrame(frame);
        else {
          marks.forEach((m) => m.classList.add('shown'));
          fig.classList.remove('flying', 'burning');
          setTimeout(() => (rocket.style.opacity = '0'), 600);
        }
      };
      raf = requestAnimationFrame(frame);
    }

    motorBtns.forEach((b) =>
      b.addEventListener('click', () => {
        motor = b.dataset.motorBtn!;
        motorBtns.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
        launch();
      }),
    );
    angleIn.addEventListener('input', () => (angleOut.textContent = `${angleIn.value}°`));
    angleIn.addEventListener('change', launch);
    fig.querySelector('[data-launch]')!.addEventListener('click', launch);

    // First flight when the panel scrolls into view
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        io.disconnect();
        setTimeout(launch, 450);
      }
    });
    io.observe(fig);
  });
</script>
