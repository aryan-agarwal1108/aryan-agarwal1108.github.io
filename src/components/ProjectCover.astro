---
// Shows the project's cover image, or a generated blueprint-style drawing as a placeholder.
import { url } from '../utils';

interface Props {
  title: string;
  category: string;
  art?: string;
  cover?: string;
  fig?: string;
  class?: string;
  eager?: boolean;
}
const { title, category, art, cover, fig = '01', class: cls = '', eager = false } = Astro.props;

const T = (x: number, y: number, s: string, anchor = 'start') =>
  `<text x="${x}" y="${y}" text-anchor="${anchor}" fill="currentColor" stroke="none">${s}</text>`;

const drawings: Record<string, string> = {
  // Airfoil with propeller disk ahead and slipstream lines
  Aerodynamics: `
    <path d="M150 140c10-26 60-40 120-38s80 18 90 32c-30 6-120 14-210 6z"/>
    <path d="M150 138h210" stroke-dasharray="2 4"/>
    <path d="M96 78v128" stroke-width="2"/>
    <ellipse cx="96" cy="142" rx="7" ry="64"/>
    ${[96, 112, 128, 156, 172, 188].map((y, i) => `<path d="M30 ${y}C80 ${y} 110 ${y + (i < 3 ? 4 : -4)} 150 ${y + (i < 3 ? -2 : 6)}S300 ${y + (i < 3 ? -8 : 10)} 380 ${y + (i < 3 ? -4 : 6)}" stroke-dasharray="${i % 2 ? '6 5' : '1 0'}" opacity="0.7"/>`).join('')}
    <path d="M250 70v26M244 82l6-12 6 12"/>
    ${T(262, 72, 'ΔL')}
    ${T(96, 228, 'PROP DISK', 'middle')}`,
  // Hybrid rocket fuel grain on a spinning mandrel
  Propulsion: `
    <rect x="90" y="80" width="220" height="100" rx="6"/>
    <rect x="90" y="112" width="220" height="36" stroke-dasharray="4 4"/>
    <path d="M60 130h280" stroke-dasharray="10 4 2 4"/>
    <path d="M60 116v28M340 116v28"/>
    <path d="M200 46a26 10 0 1 1-1 0" />
    <path d="M226 44l-6 6 8 2"/>
    ${T(240, 40, 'ω')}
    <path d="M90 196h220M90 190v12M310 190v12"/>
    ${T(200, 216, 'FUEL GRAIN', 'middle')}
    ${[110, 140, 170, 230, 260, 290].map((x) => `<path d="M${x} 82l-10 28M${x} 180l-10-30" opacity="0.45"/>`).join('')}`,
  // eVTOL top view with four rotors and flotation chambers
  'Mechanical Design': `
    <rect x="170" y="70" width="60" height="120" rx="28"/>
    <path d="M170 104l-60-30M230 104l60-30M170 156l-60 30M230 156l60 30"/>
    ${[[110, 74], [290, 74], [110, 186], [290, 186]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="34" stroke-dasharray="3 4"/><circle cx="${x}" cy="${y}" r="5"/>`).join('')}
    <rect x="140" y="88" width="20" height="84" rx="10" stroke-dasharray="5 3"/>
    <rect x="240" y="88" width="20" height="84" rx="10" stroke-dasharray="5 3"/>
    <path d="M262 130h48"/><circle cx="314" cy="130" r="3"/>
    ${T(320, 134, 'FLOAT')}`,
  // Quantum circuit: 3 qubit wires, gates, entangling CNOT, measurement
  Quantum: `
    ${[80, 130, 180].map((y, i) => `<path d="M50 ${y}h300"/>${T(40, y + 4, `q${i}`, 'end')}`).join('')}
    <rect x="80" y="66" width="28" height="28" rx="3"/>${T(94, 85, 'H', 'middle')}
    <rect x="80" y="116" width="28" height="28" rx="3"/>${T(94, 135, 'H', 'middle')}
    <circle cx="150" cy="80" r="4" fill="currentColor"/><path d="M150 80v58"/><circle cx="150" cy="130" r="9"/>
    <circle cx="200" cy="130" r="4" fill="currentColor"/><path d="M200 130v58"/><circle cx="200" cy="180" r="9"/>
    <rect x="232" y="66" width="40" height="28" rx="3"/>${T(252, 85, 'Rθ', 'middle')}
    <rect x="232" y="166" width="40" height="28" rx="3"/>${T(252, 185, 'Rφ', 'middle')}
    ${[80, 130, 180].map((y) => `<rect x="300" y="${y - 14}" width="30" height="28" rx="3"/><path d="M306 ${y + 6}a9 9 0 0 1 18 0M315 ${y + 6}l7-10"/>`).join('')}`,
  // Superconducting nanowire meander with an incoming photon
  Detector: `
    <rect x="120" y="60" width="160" height="140" rx="4"/>
    <path d="M140 80h120v14H140v14h120v14H140v14h120v14H140v14h120" />
    <path d="M140 80H90v100h50M260 178h50V80h-50" stroke-dasharray="3 3"/>
    <path d="M200 20c4 6-4 10 0 16s-4 10 0 16" />
    <path d="M195 46l5 10 5-10"/>
    ${T(214, 34, 'hν')}
    <path d="M90 130h-40M310 130h40"/>
    ${T(50, 122, 'BIAS')}
    ${T(350, 122, 'OUT', 'end')}
    ${T(200, 222, 'SC NANOWIRE', 'middle')}`,
  // Polarized wave through scattering medium
  Optics: `
    <path d="M30 130h340" stroke-dasharray="2 4"/>
    <path d="M30 130${Array.from({ length: 6 }, (_, i) => `q12 ${i % 2 ? 40 : -40} 24 0`).join('')}"/>
    <rect x="178" y="70" width="12" height="120" rx="2"/>
    ${[[220, 100], [246, 150], [268, 112], [292, 160], [314, 96], [340, 140], [232, 176], [300, 128]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="${3 + ((x + y) % 4)}"/>`).join('')}
    ${[[246, 150], [314, 96]].map(([x, y]) => `<path d="M${x + 6} ${y - 6}l18-18M${x + 6} ${y + 6}l18 18" stroke-dasharray="3 3"/>`).join('')}
    ${T(184, 62, 'POLARIZER', 'middle')}
    ${T(100, 200, 'λ', 'middle')}`,
};
const fallback = `
  <rect x="80" y="50" width="240" height="160" rx="4"/>
  <path d="M80 90h240M80 130h240M80 170h240M140 50v160M200 50v160M260 50v160" stroke-dasharray="2 5"/>
  <circle cx="200" cy="130" r="40"/>`;
const drawing = drawings[art ?? category] ?? drawings[category] ?? fallback;
---

<div class:list={['corners blueprint-fill relative aspect-[16/10] overflow-hidden rounded-[inherit]', cls]}>
  {
    cover ? (
      <img
        src={url(cover)}
        alt={`${title}, cover image`}
        class="absolute inset-0 size-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <>
        <svg
          viewBox="0 0 400 260"
          class="absolute inset-0 m-auto h-[78%] w-[78%] text-accent/75"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          font-family="Geist Mono, monospace"
          font-size="11"
          aria-hidden="true"
          set:html={drawing}
        />
        <span class="absolute top-3 left-3 font-mono text-[0.62rem] tracking-widest text-faint uppercase">FIG. {fig}</span>
        <span class="absolute right-3 bottom-3 font-mono text-[0.62rem] tracking-widest text-faint uppercase">
          {category}
        </span>
        <span class="sr-only">{`Illustration for ${title}`}</span>
      </>
    )
  }
</div>
