---
// Shows the project's cover image, or a generated blueprint-style drawing as a placeholder.
import { url } from '../utils';

interface Props {
  title: string;
  category: string;
  cover?: string;
  fig?: string;
  class?: string;
  eager?: boolean;
}
const { title, category, cover, fig = '01', class: cls = '', eager = false } = Astro.props;

const drawings: Record<string, string> = {
  Embedded: `
    <rect x="150" y="70" width="100" height="100" rx="4"/>
    <rect x="172" y="92" width="56" height="56" rx="2" stroke-dasharray="3 3"/>
    ${[0, 1, 2, 3, 4].map((i) => `<path d="M${165 + i * 17} 70v-22M${165 + i * 17} 170v22M150 ${85 + i * 17}h-22M250 ${85 + i * 17}h22"/>`).join('')}
    <path d="M128 85H80v-30M272 136h52v40h40M183 192v26h-60M233 48V24h70"/>
    <circle cx="80" cy="52" r="4"/><circle cx="364" cy="176" r="4"/><circle cx="120" cy="218" r="4"/><circle cx="306" cy="24" r="4"/>`,
  Hardware: `
    <path d="M60 120h50l12-28 20 56 20-56 20 56 20-56 12 28h40"/>
    <path d="M254 120h20M274 96v48M290 96v48M290 120h40"/>
    <path d="M330 120v-50h-270v50M330 120v50h-270v-50" stroke-dasharray="4 4"/>
    <circle cx="60" cy="120" r="5"/><circle cx="330" cy="120" r="5"/>
    <path d="M150 190h100M150 184v12M250 184v12" /><text x="200" y="210" text-anchor="middle">R = 4.7kΩ</text>`,
  CAD: `
    <path d="M200 40 300 95v110l-100 55-100-55V95z"/>
    <path d="M200 150 300 95M200 150 100 95M200 150v110"/>
    <path d="M200 40v110" stroke-dasharray="3 4"/>
    <circle cx="200" cy="150" r="26" stroke-dasharray="2 3"/>
    <path d="M318 95v110M312 95h12M312 205h12"/><text x="332" y="154">110</text>`,
  Software: `
    <rect x="70" y="50" width="260" height="160" rx="6"/>
    <path d="M70 76h260"/><circle cx="86" cy="63" r="3"/><circle cx="98" cy="63" r="3"/><circle cx="110" cy="63" r="3"/>
    <path d="M96 104l-14 14 14 14M124 132l14-14-14-14"/>
    <path d="M160 104h120M160 120h80M160 136h100M96 160h180M96 176h120" stroke-dasharray="1 0"/>`,
  Research: `
    <path d="M70 40v170h270"/>
    <path d="M70 180c40-10 60-90 100-100s60 40 90 30 50-60 80-70" />
    <path d="M70 196c50-6 80-40 120-50s70 10 100 0 40-30 50-36" stroke-dasharray="4 4"/>
    ${[110, 150, 190, 230, 270, 310].map((x) => `<path d="M${x} 210v6"/>`).join('')}
    ${[60, 100, 140, 180].map((y) => `<path d="M64 ${y}h6"/>`).join('')}`,
};
const drawing = drawings[category] ?? drawings.Software;
---

<div class:list={['corners blueprint-fill relative aspect-[16/10] overflow-hidden rounded-[inherit]', cls]}>
  {
    cover ? (
      <img
        src={url(cover)}
        alt={`${title} — cover image`}
        class="absolute inset-0 size-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <>
        <svg
          viewBox="0 0 400 260"
          class="absolute inset-0 m-auto h-[78%] w-[78%] text-accent/70"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          font-family="Geist Mono, monospace"
          font-size="10"
          aria-hidden="true"
          set:html={drawing.replace(/<text /g, '<text fill="currentColor" stroke="none" ')}
        />
        <span class="absolute top-3 left-3 font-mono text-[0.62rem] tracking-widest text-faint uppercase">FIG. {fig}</span>
        <span class="absolute right-3 bottom-3 font-mono text-[0.62rem] tracking-widest text-faint uppercase">
          {category}
        </span>
        <span class="sr-only">{`Placeholder drawing for ${title}`}</span>
      </>
    )
  }
</div>
