---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../config';
import { url } from '../utils';
const year = new Date().getFullYear();
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  { href: '/papers', label: 'Papers' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="relative z-10 mt-28 overflow-hidden border-t border-line">
  <div class="h-px bg-line"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-14 pb-8 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <Logo size={40} class="text-fg" />
        <div>
          <p class="display text-lg font-extrabold uppercase [font-stretch:125%]">{site.name}</p>
          <p class="font-mono text-xs text-faint">{site.major} · {site.schoolShort}</p>
        </div>
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">
        Open to Summer 2027 internships in aerospace, propulsion, and research.
      </p>
      <a href={`mailto:${site.email}`} class="mt-2 inline-block py-1.5 text-sm text-fg underline decoration-accent underline-offset-4">{site.email}</a>
    </div>
    <div>
      <p class="label mb-4">Pages</p>
      <ul class="space-y-1 text-sm">
        {links.map((l) => <li><a href={url(l.href)} class="inline-block py-1 text-muted transition-colors hover:text-fg">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="label mb-4">Elsewhere</p>
      <ul class="space-y-1 text-sm">
        <li><a href={site.links.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 py-1 text-muted transition-colors hover:text-fg"><Icon name="linkedin" size={14} />LinkedIn</a></li>
        <li><a href={site.links.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 py-1 text-muted transition-colors hover:text-fg"><Icon name="github" size={15} />GitHub</a></li>
        <li><a href={url(site.resume)} class="inline-flex items-center gap-2 py-1 text-muted transition-colors hover:text-fg"><Icon name="file" size={15} />Resume (PDF)</a></li>
      </ul>
    </div>
  </div>


  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-5 font-mono text-[0.7rem] tracking-wide text-faint sm:px-6">
    <span>© {year} {site.name}</span>
    <span class="hidden sm:inline">Urbana-Champaign, IL</span>
    <a href="#top" class="inline-flex items-center gap-1.5 py-1.5 uppercase transition-colors hover:text-fg">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>
