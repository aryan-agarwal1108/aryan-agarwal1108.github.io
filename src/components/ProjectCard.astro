---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import Icon from './Icon.astro';
import { url, pad } from '../utils';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  size?: 'lg' | 'md';
  recent?: number; // position in "Most recent" order (projects page sorting)
}
const { project, index, size = 'md', recent } = Astro.props;
const p = project.data;

// Short status pill: In progress / Flown / Completed
const live = /progress|present/i.test(`${p.status ?? ''} ${p.timeline}`);
const pill = live ? 'In progress' : /flown/i.test(p.status ?? '') ? 'Flown' : 'Completed';
---

<a
  href={url(`/projects/${project.id}`)}
  class="card reveal group flex h-full flex-col overflow-hidden"
  data-category={p.category}
  data-tags={p.tags.map((t) => t.toLowerCase()).join('|')}
  data-rec={index}
  data-recent={recent}
>
  <div class="relative overflow-hidden border-b border-line">
    <ProjectCover title={p.title} category={p.category} art={p.art} cover={p.cover} fig={pad(index + 1)} />
    <span
      class:list={[
        'absolute top-2.5 right-2.5 z-[5] inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[0.6rem] font-medium tracking-[0.1em] uppercase shadow-sm',
        live ? 'bg-white text-[#14161c]' : 'bg-white/90 text-[#14161c]',
      ]}
    >
      <span class:list={['size-1.5 rounded-full', live ? 'animate-pulse bg-[#138a43]' : 'bg-[#8a8f98]']} />
      {pill}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-3 font-mono text-[0.68rem] tracking-wider text-faint uppercase">
      <span class="flex items-center gap-2 text-fg"><span class="size-1.5 bg-accent"></span>{p.category}</span>
      <span class="truncate">{p.timeline}</span>
    </div>
    <h3 class:list={['display leading-tight text-fg', size === 'lg' ? 'text-[1.35rem]' : 'text-lg']}>
      {p.title}
      <Icon
        name="external"
        size={15}
        class="ml-1 inline -translate-y-px text-faint transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
      />
    </h3>
    <p class="text-sm leading-relaxed text-muted">{p.summary}</p>
    {
      p.result && (
        <p class="flex items-start gap-2 text-sm text-fg">
          <span class="mt-[0.6em] h-px w-4 shrink-0 bg-accent" />
          {p.result}
        </p>
      )
    }
    <p class="text-xs leading-relaxed text-faint">
      <span class="text-muted">{p.role}</span>{p.org && <> · {p.org}</>}
    </p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label="Tools">
      {p.tags.slice(0, 6).map((t) => <li class="tag">{t}</li>)}
      {p.tags.length > 6 && <li class="tag !text-faint">+{p.tags.length - 6}</li>}
    </ul>
  </div>
</a>
