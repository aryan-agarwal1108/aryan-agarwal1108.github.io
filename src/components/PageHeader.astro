---
// Shared header for top-level pages: mono label, big title, short intro.
interface Props {
  tag: string;
  label: string;
  title: string;
}
const { tag, label, title } = Astro.props;
---

<div class="reveal">
  <p class="label flex items-center gap-3">
    <span class="text-accent">{tag}</span><span class="h-px w-8 bg-line-strong"></span>{label}
  </p>
  <h1 class="mt-4 text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
    {title}<span class="text-accent">.</span>
  </h1>
  <div class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
    <slot />
  </div>
</div>
