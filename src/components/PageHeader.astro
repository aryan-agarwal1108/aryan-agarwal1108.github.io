---
// Shared header for top-level pages: label, huge livery title that rises in, short intro.
interface Props {
  tag?: string; // no longer shown
  label: string;
  title: string;
}
const { tag, label, title } = Astro.props;
---

<div>
  <p class="hero-in label">{label}</p>
  <h1 class="livery mt-6 text-[clamp(1.9rem,8vw,5.5rem)]">
    <span class="rise"><span>{title}</span></span>
  </h1>
  <div class="hero-in mt-8 h-px bg-line" style="--d:0.25s"></div>
  <div class="hero-in mt-6 max-w-2xl text-lg leading-relaxed text-muted" style="--d:0.3s">
    <slot />
  </div>
</div>
