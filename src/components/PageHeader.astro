---
// Shared header for top-level pages: label, huge livery title that rises in, short intro.
interface Props {
  tag: string;
  label: string;
  title: string;
}
const { tag, label, title } = Astro.props;
---

<div>
  <p class="hero-in flex items-center gap-3">
    <span class="grid h-6 place-items-center bg-accent px-2 font-mono text-[0.68rem] font-medium text-on-accent">{tag}</span>
    <span class="label">{label}</span>
  </p>
  <h1 class="livery mt-6 text-[clamp(1.9rem,8.4vw,7rem)]">
    <span class="rise"><span>{title}<span class="text-accent">.</span></span></span>
  </h1>
  <div class="ruler hero-in mt-8" style="--d:0.25s"></div>
  <div class="hero-in mt-6 max-w-2xl text-lg leading-relaxed text-muted" style="--d:0.3s">
    <slot />
  </div>
</div>
