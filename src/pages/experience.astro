---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import Icon from '../components/Icon.astro';
import { site, experience, leadership } from '../config';
import { url } from '../utils';
---

<BaseLayout title="Experience" description={`Research roles, leadership, and skills of ${site.name}.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <PageHeader tag="EXPERIENCE" label="Roles & skills" title="Experience">
      Research labs, club teams, and what I've done outside them. Roles with a project link have a full write-up.
    </PageHeader>
    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a href={url('/resume')} class="inline-flex h-10 items-center gap-2 rounded-lg border border-line-strong bg-surface px-4 text-sm font-medium transition-colors hover:border-fg">
        <Icon name="file" size={15} /> Full resume
      </a>
      <a href={url('/projects')} class="inline-flex h-10 items-center gap-2 rounded-lg border border-line px-4 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg">
        All projects <Icon name="arrow" size={15} />
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20 pb-10 sm:px-6">
    <SectionHeading index="01" label="Research & engineering" title="Where I've worked" />
    <Timeline items={experience} />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading index="02" label="Leadership & activities" title="Outside the lab" />
    <Timeline items={leadership} compact />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading index="03" label="Toolkit" title="What I work with">
      <p class="max-w-xs text-sm text-muted">
        Tools with a <span class="font-mono text-accent-2">number</span> link to the projects I used them on.
      </p>
    </SectionHeading>
    <Skills />
  </section>
</BaseLayout>
