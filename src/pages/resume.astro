---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, education, experience, leadership, skills, awards, type Experience } from '../config';
import { url } from '../utils';

const sections: { title: string; items: Experience[] }[] = [
  { title: 'Experience', items: experience },
  { title: 'Leadership & Activities', items: leadership },
];
const dates = (e: Experience) =>
  e.upcoming ? `Starting ${e.start ?? 'soon'}` : [e.start, e.end].filter(Boolean).join(' – ');
---

<BaseLayout title="Resume" description={`Resume of ${site.name}, ${site.major} student at ${site.schoolShort}.`}>
  <section class="mx-auto max-w-4xl px-4 pt-16 sm:px-6 sm:pt-20">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="label flex items-center gap-3"><span class="text-accent">DOC-002</span><span class="h-px w-8 bg-line-strong"></span>Resume</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-[-0.035em] sm:text-6xl">Resume<span class="text-accent">.</span></h1>
      </div>
      <div class="flex gap-3">
        <a href={url(site.resume)} download class="inline-flex h-11 items-center gap-2 rounded-lg bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85">
          <Icon name="download" size={16} /> Download PDF
        </a>
        <a href={url(site.resume)} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-lg border border-line-strong px-5 text-sm font-medium transition-colors hover:border-fg">
          Open <Icon name="external" size={15} />
        </a>
      </div>
    </div>

    <!-- HTML version: readable on phones and searchable by applicant-tracking systems -->
    <div class="reveal corners mt-10 rounded-xl border border-line bg-surface p-6 sm:p-10">
      <header class="border-b border-line pb-6">
        <h2 class="text-2xl font-semibold tracking-tight">{site.name}</h2>
        <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
          <a href={`mailto:${site.email}`} class="hover:text-fg">{site.email}</a>
          <a href={site.links.linkedin} class="hover:text-fg">{site.links.linkedin.replace('https://www.', '')}</a>
          <span>{site.location}</span>
        </p>
      </header>

      <div class="mt-8">
        <h3 class="label mb-4">Education</h3>
        <div class="space-y-5">
          {
            education.map((e) => (
              <div>
                <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
                  <p class="font-medium">{e.school}</p>
                  <p class="font-mono text-xs text-faint uppercase">{e.location} · {e.date}</p>
                </div>
                <p class="mt-1 text-sm text-muted italic">{e.degree}</p>
                {e.details && (
                  <ul class="mt-1.5 space-y-1 text-sm text-muted">
                    {e.details.map((d) => <li class="relative pl-4"><span class="absolute left-0 text-accent">·</span>{d}</li>)}
                  </ul>
                )}
              </div>
            ))
          }
        </div>
      </div>

      {
        sections.map((s) => (
          <div class="mt-9">
            <h3 class="label mb-4">{s.title}</h3>
            <div class="space-y-6">
              {s.items.map((e) => (
                <div>
                  <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
                    <p class="font-medium">{e.role}</p>
                    <p class="font-mono text-xs text-faint uppercase">{e.location}</p>
                  </div>
                  <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
                    <p class="text-sm text-muted italic">{e.org}</p>
                    <p class="font-mono text-xs text-faint uppercase">{dates(e)}</p>
                  </div>
                  <ul class="mt-2 space-y-1 text-sm text-muted">
                    {e.bullets.map((b) => <li class="relative pl-4"><span class="absolute left-0 text-accent">·</span>{b}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <div class="mt-9">
        <h3 class="label mb-4">Honors & Awards</h3>
        <ul class="space-y-1.5 text-sm">
          {
            awards.map((a) => (
              <li class="flex flex-wrap justify-between gap-x-4 gap-y-0.5">
                <span>
                  <span class="text-fg">{a.rank}</span> <span class="text-muted">({a.context}): {a.title}, {a.org}</span>
                </span>
                <span class="font-mono text-xs text-faint">{a.year}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-9">
        <h3 class="label mb-4">Technical Skills</h3>
        <dl class="space-y-1.5 text-sm">
          {skills.map((s) => <div class="flex flex-wrap gap-x-2"><dt class="text-fg">{s.group}:</dt><dd class="text-muted">{s.items.join(', ')}</dd></div>)}
        </dl>
      </div>
    </div>

    <p class="mt-4 text-center font-mono text-xs text-faint">
      Prefer the original? <a href={url(site.resume)} class="underline decoration-accent underline-offset-4 hover:text-fg">Open the PDF</a>.
    </p>
  </section>
</BaseLayout>
