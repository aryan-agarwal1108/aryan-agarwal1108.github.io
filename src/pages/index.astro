---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import Awards from '../components/Awards.astro';
import { site, experience, leadership, skills, highlights } from '../config';
import { getProjects, getToolCounts } from '../lib/projects';
import { url } from '../utils';

const all = await getProjects();
const featured = all.filter((p) => p.data.featured).slice(0, 4);
const toolCounts = await getToolCounts();

const specs = [
  ['Name', site.name],
  ['Studying', 'Aerospace Eng. + Physics'],
  ['School', site.schoolShort],
  ['Class of', site.gradYear],
  ['Based in', site.location],
  ['Previously', site.previously],
  ['Projects', String(all.length).padStart(2, '0')],
];
---

<BaseLayout>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 lg:pb-28">
    <!-- Faint trajectory sketch behind the hero -->
    <svg
      class="pointer-events-none absolute -top-6 right-0 -z-0 hidden h-[460px] w-[760px] text-accent-2 opacity-40 lg:block"
      viewBox="0 0 760 460"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path d="M20 440C180 120 470 30 740 120" stroke-dasharray="2 7" stroke-width="1.2" />
      <path d="M60 440C230 190 450 110 700 170" stroke-dasharray="1 9" stroke-width="1" opacity="0.6" />
      <ellipse cx="560" cy="210" rx="230" ry="70" transform="rotate(-12 560 210)" stroke-dasharray="3 6" opacity="0.5" />
      <circle cx="740" cy="120" r="3" fill="currentColor" />
    </svg>

    <div class="relative grid items-center gap-12 lg:grid-cols-[1.35fr_1fr]">
      <div class="hero-in">
        {
          site.status.available && (
            <p class="mb-8 inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-muted">
              <span class="pulse-dot" />
              {site.status.text}
            </p>
          )
        }
        <h1 class="text-5xl leading-[0.95] font-semibold tracking-[-0.045em] text-balance sm:text-7xl">
          {site.name}<span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted sm:text-xl">
          <span class="text-fg">{site.major} @ {site.schoolShort}.</span>{' '}
          {site.tagline}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={url('/projects')}
            class="inline-flex h-11 items-center gap-2 rounded-lg bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
          >
            See my projects <Icon name="arrow" size={16} />
          </a>
          <a
            href={url('/resume')}
            class="inline-flex h-11 items-center gap-2 rounded-lg border border-line-strong bg-surface px-5 text-sm font-medium transition-colors hover:border-fg"
          >
            <Icon name="file" size={16} /> Resume
          </a>
          <div class="ml-1 flex items-center gap-1">
            <a href={site.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-lg text-muted transition-colors hover:text-fg"><Icon name="linkedin" size={18} /></a>
            <a href={site.links.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-11 place-items-center rounded-lg text-muted transition-colors hover:text-fg"><Icon name="github" size={19} /></a>
            <a href={`mailto:${site.email}`} aria-label="Email" class="grid size-11 place-items-center rounded-lg text-muted transition-colors hover:text-fg"><Icon name="mail" size={19} /></a>
          </div>
        </div>
      </div>

      <!-- Datasheet card -->
      <aside class="hero-in hero-in-2 corners rounded-xl border border-line bg-surface/85 shadow-[0_24px_60px_-30px_rgb(0_0_0/0.45)] backdrop-blur-sm" aria-label="Quick facts">
        <div class="flex items-center justify-between border-b border-line px-5 py-3">
          <span class="label">Datasheet</span>
          <span class="font-mono text-[0.65rem] text-faint">DOC-001 · REV B</span>
        </div>
        <dl class="divide-y divide-line">
          {
            specs.map(([k, v]) => (
              <div class="flex items-baseline justify-between gap-6 px-5 py-3">
                <dt class="font-mono text-xs tracking-wider text-faint uppercase">{k}</dt>
                <dd class="text-right text-sm text-fg">{v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="flex items-center justify-between border-t border-line px-5 py-3 font-mono text-[0.65rem] text-faint">
          <span>STATUS</span>
          <span class="flex items-center gap-2 text-ok"><span class="size-1.5 rounded-full bg-ok"></span>AVAILABLE · SUMMER 2027</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- ── SELECTED WORK ────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="work">
    <SectionHeading index="01" label="Selected work" title="A few things I've worked on" id="work">
      <a href={url('/projects')} class="group inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg">
        All {all.length} projects <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    </SectionHeading>
    <div class="grid gap-5 md:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} index={i} size="lg" />)}
    </div>
  </section>

  <!-- ── EXPERIENCE ───────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6" id="experience">
    <SectionHeading index="02" label="Experience" title="Where I've worked" />
    <Timeline items={experience} />

    <div class="mt-16">
      <h3 class="reveal label mb-8 flex items-center gap-3"><span class="h-px w-8 bg-line-strong"></span>Leadership & activities</h3>
      <Timeline items={leadership} compact />
    </div>
  </section>

  <!-- ── AWARDS ───────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6" id="awards">
    <SectionHeading index="03" label="Awards & competitions" title="Competition results" />
    <Awards />
  </section>

  <!-- ── SKILLS ───────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading index="04" label="Toolkit" title="What I work with" id="skills">
      <p class="max-w-xs text-sm text-muted">
        Tools with a <span class="font-mono text-accent-2">number</span> link to the projects I used them on.
      </p>
    </SectionHeading>
    <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      {
        skills.map((s) => (
          <div class="reveal bg-surface p-6">
            <h3 class="label mb-4">{s.group}</h3>
            <ul class="flex flex-wrap gap-2">
              {s.items.map((i) => {
                const n = toolCounts.get(i.toLowerCase());
                return (
                  <li>
                    {n ? (
                      <a
                        href={url(`/projects?tool=${encodeURIComponent(i.toLowerCase())}`)}
                        class="skill inline-flex items-center gap-2 rounded-md border border-line bg-surface-2 px-2.5 py-1 text-sm text-fg transition-colors"
                        title={`See ${n} project${n === 1 ? '' : 's'} using ${i}`}
                      >
                        {i}
                        <span class="rounded bg-accent-2-soft px-1.5 font-mono text-[0.65rem] text-accent-2">{n}</span>
                      </a>
                    ) : (
                      <span class="inline-block rounded-md border border-line bg-surface-2 px-2.5 py-1 text-sm text-muted">{i}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── ABOUT (personal) ─────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading index="05" label="About me" title="A bit about me" id="about-me" />
    <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
      <div class="reveal corners w-full max-w-[280px] self-start overflow-hidden rounded-xl border border-line bg-surface">
        <div class="blueprint-fill grid aspect-square place-items-center">
          <!-- Swap for a photo: <img src={url('/images/headshot.jpg')} alt="Aryan Agarwal" class="size-full object-cover" /> -->
          <span class="font-mono text-6xl font-medium tracking-tight text-accent/80">{site.initials}</span>
        </div>
        <div class="flex items-center gap-2 border-t border-line px-4 py-3 text-sm text-muted">
          <Icon name="pin" size={15} />{site.location} · prev. {site.previously}
        </div>
      </div>
      <div class="reveal flex flex-col">
        <div class="space-y-4 text-lg leading-relaxed text-muted">
          <p>
            I'm <span class="text-fg">{site.firstName}</span>. I'm in my first year at Illinois, doing a dual degree in{' '}
            <span class="text-fg">Aerospace Engineering and Physics</span>. Before college I was in Dubai, and I spent a lot of
            high school in research labs around the UAE, working on single-photon detectors at TII, then a water-landing drone and
            quantum machine learning at NYU Abu Dhabi.
          </p>
          <p>
            Outside my own projects, I started <a href={leadership[0].href} target="_blank" rel="noopener" class="text-fg underline decoration-accent underline-offset-4">Erudios</a>,
            a free mentorship program that paired over 1,000 high schoolers with university students to do real research. I
            also play golf and guitar.
          </p>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
          {
            highlights.map((h) => (
              <div class="bg-surface p-4">
                <dd class="text-2xl font-semibold tracking-tight text-fg">{h.value}</dd>
                <dt class="mt-1 text-xs leading-snug text-faint">{h.label}</dt>
              </div>
            ))
          }
        </dl>
        <a href={url('/about')} class="group mt-6 inline-flex items-center gap-1.5 self-start text-sm text-muted transition-colors hover:text-fg">
          More about me <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" id="contact" aria-labelledby="contact-h">
    <div class="reveal corners relative overflow-hidden rounded-2xl border border-line bg-surface px-6 py-14 sm:px-12 sm:py-20">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_80%_at_100%_100%,var(--accent-soft),transparent_70%)]" aria-hidden="true"></div>
      <p class="label relative flex items-center gap-3"><span class="text-accent">06</span><span class="h-px w-8 bg-line-strong"></span>Contact</p>
      <h2 id="contact-h" class="relative mt-5 max-w-2xl text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
        Want to talk<span class="text-accent">?</span>
      </h2>
      <p class="relative mt-5 max-w-lg text-muted">
        I'm looking for a Summer 2027 internship in aerospace, propulsion, or research. If you're hiring, have a question about
        something here, or just want to talk rockets, send me an email.
      </p>
      <div class="relative mt-9 flex flex-wrap gap-3">
        <button
          type="button"
          data-copy={site.email}
          class="inline-flex h-11 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-medium text-white transition-opacity hover:opacity-90"
        >
          <Icon name="copy" size={16} /><span data-copy-label>Copy email</span>
        </button>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-line-strong px-5 text-sm font-medium transition-colors hover:border-fg"
        >
          <Icon name="mail" size={16} />{site.email}
        </a>
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener"
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-line-strong px-5 text-sm font-medium transition-colors hover:border-fg"
        >
          <Icon name="linkedin" size={15} />LinkedIn
        </a>
      </div>
      <svg class="pointer-events-none absolute -right-16 -bottom-16 hidden h-80 w-80 text-line-strong md:block" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="100" cy="100" r="90" stroke-dasharray="2 4" />
        <circle cx="100" cy="100" r="60" />
        <circle cx="100" cy="100" r="30" stroke-dasharray="6 4" />
        <path d="M100 0v200M0 100h200" stroke-dasharray="1 5" />
      </svg>
    </div>
  </section>
</BaseLayout>
