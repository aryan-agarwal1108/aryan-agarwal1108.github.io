---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NowPanel from '../components/NowPanel.astro';
import Icon from '../components/Icon.astro';
import { site, experience, awards, highlights, papers, updates } from '../config';
import { getProjects } from '../lib/projects';
import { url } from '../utils';

const all = await getProjects();
const featured = all.filter((p) => p.data.featured).slice(0, 4);
const currentRoles = experience.filter((e) => !e.upcoming).length;

// Measured results strip (all from projects / awards on the site)
const stats: { value: string; label: string; href: string; count?: number; prefix?: string; suffix?: string }[] = [
  { value: '<8 s', label: 'Float deployment on my eVTOL drone', href: '/projects/evtol-water-landing' },
  { value: 'Top 50', label: 'of 508 teams, CERN Beamline for Schools', href: '/resume#awards' },
  { value: '1 of 52', label: 'World Science Scholars worldwide', href: '/resume#leadership' },
  { value: '1,000+', label: 'Students mentored through Erudios', href: '/about', count: 1000, suffix: '+' },
  { value: 'Jan ’27', label: 'Starting hypersonics research at CHESS', href: '/resume#experience' },
];

const ticker = ['Aerodynamics', 'Computational fluid dynamics', 'Rocket propulsion', 'Manufacturing', 'Structures', 'Thermal analysis', 'Aircraft design', 'Space systems', 'Orbital mechanics', 'Mission operations'];

// Cards that point to each of the other pages. `count` animates up when visible.
const explore = [
  {
    href: '/resume',
    kicker: 'Resume',
    count: currentRoles,
    stat: String(currentRoles),
    statLabel: 'research & engineering roles',
    title: "Where I've worked",
    text: 'Labs at UIUC, NYU Abu Dhabi, and TII, plus leadership, activities, and the tools I use.',
    cta: 'See resume',
  },
  {
    href: '/resume#awards',
    kicker: 'Awards',
    stat: awards[0].rank,
    statLabel: `${awards[0].org} ${awards[0].title}`,
    title: 'Competition results',
    text: 'Physics, astronomy, and math competitions, plus recognition from my research.',
    cta: 'See awards',
  },
  {
    href: '/about',
    kicker: 'About',
    count: 1000,
    suffix: '+',
    stat: highlights[1].value,
    statLabel: 'high schoolers mentored through Erudios',
    title: 'A bit about me',
    text: 'How I went from Dubai to UIUC, what I do now, and life outside engineering.',
    cta: 'About me',
  },
  {
    href: '/papers',
    kicker: 'Papers',
    count: papers.length,
    stat: String(papers.length),
    statLabel: 'research papers and proposals',
    title: 'Research papers',
    text: 'Quantum ML, particle physics, optics, and more, each with an abstract and the PDF.',
    cta: 'Read papers',
  },
];
---

<BaseLayout
  sections={[
    { id: 'work', label: 'Selected work' },
    { id: 'updates', label: 'Latest updates' },
    { id: 'explore', label: 'Explore' },
    { id: 'contact', label: 'Contact' },
  ]}
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="relative mx-auto max-w-6xl px-4 pt-12 pb-14 sm:px-6 sm:pt-20" id="overview">
    <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        <p class="hero-in mb-7 inline-flex items-center gap-2 text-sm text-muted">
          <span class="size-2 rounded-full bg-[var(--ok)]" aria-hidden="true"></span>
          {site.status.text}
        </p>

        <h1 class="livery text-[clamp(2.5rem,6vw,5.25rem)]">
          <span class="rise"><span>Aryan</span></span>
          <span class="rise"><span style="--d:0.12s">Agarwal</span></span>
        </h1>

        <p class="hero-in mt-6 text-base font-medium text-fg sm:text-lg" style="--d:0.3s">
          Aerospace Engineering & Physics, University of Illinois Urbana-Champaign
        </p>
        <p class="hero-in mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted" style="--d:0.38s">
          {site.tagline}
        </p>

        <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d:0.46s">
          <a
            href={url('/projects')}
            class="group inline-flex h-12 items-center gap-2.5 bg-fg px-6 text-sm font-semibold tracking-[0.06em] text-bg uppercase transition-colors hover:bg-accent hover:text-on-accent"
          >
            See my projects <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href={url('/resume')}
            class="inline-flex h-12 items-center gap-2 border border-fg px-6 text-sm font-semibold tracking-[0.06em] uppercase transition-colors hover:bg-fg hover:text-bg"
          >
            <Icon name="file" size={16} /> Resume
          </a>
          <div class="ml-1 flex items-center">
            <a href={site.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-12 place-items-center text-muted transition-colors hover:text-accent"><Icon name="linkedin" size={18} /></a>
            <a href={site.links.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-12 place-items-center text-muted transition-colors hover:text-accent"><Icon name="github" size={19} /></a>
            <a href={`mailto:${site.email}`} aria-label="Email" class="grid size-12 place-items-center text-muted transition-colors hover:text-accent"><Icon name="mail" size={19} /></a>
          </div>
        </div>
      </div>

      <div class="hero-in" style="--d:0.2s">
        <NowPanel />
      </div>
    </div>

    <!-- Results strip: measured numbers, each links to the proof -->
    <div class="reveal mt-14">
      <ul class="grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-3 lg:grid-cols-5">
        {
          stats.map((s, i) => (
            <li class:list={['bg-surface', i === stats.length - 1 && 'col-span-2 sm:col-span-1']}>
              <a href={url(s.href)} class="group relative block h-full px-5 pt-5 pb-4 transition-colors hover:bg-surface-2">
                <span class="livery block text-[clamp(1.35rem,6.4vw,2rem)] normal-case text-fg">{s.value}</span>
                <span class="mt-2 block text-xs leading-snug text-muted">{s.label}</span>
                <span class="absolute bottom-0 left-0 h-[3px] w-0 bg-accent transition-all duration-500 group-hover:w-full" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── FIELDS I WANT TO WORK IN ─────────────────────────── -->
  <div class="border-y border-line bg-surface">
    <ul class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-5 gap-y-2 px-4 py-5 text-sm text-muted sm:px-6" aria-label="Fields I want to work in">
      {
        ticker.map((t, i) => (
          <li class="flex items-center gap-5">
            {i > 0 && <span class="size-1 rounded-full bg-line-strong" aria-hidden="true" />}
            {t}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- ── SELECTED WORK ────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 pt-24 pb-16 sm:px-6" aria-labelledby="work">
    <SectionHeading index="01" label="Selected work" title="A few things I've worked on" id="work">
      <a href={url('/projects')} class="group inline-flex items-center gap-2 border-b border-fg pb-1 text-sm font-semibold tracking-[0.06em] uppercase transition-colors hover:border-accent hover:text-accent">
        All {all.length} projects <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-1" />
      </a>
    </SectionHeading>
    <div class="grid gap-6 md:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} index={i} size="lg" />)}
    </div>
  </section>

  <!-- ── LATEST UPDATES (edit `updates` in config.ts) ────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" id="updates">
    <SectionHeading index="02" label="Latest updates" title="What's new" />
    <ol class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface">
      {
        updates.slice(0, 6).map((u) => {
          const Tag = u.href ? 'a' : 'div';
          return (
            <li class="reveal">
              <Tag
                href={u.href ? url(u.href) : undefined}
                class="group grid gap-1 px-5 py-4 transition-colors hover:bg-surface-2 sm:grid-cols-[8.5rem_1fr_auto] sm:items-center sm:gap-6 sm:px-6"
              >
                <span class="flex items-center gap-2 font-mono text-xs tracking-wide text-faint uppercase">
                  {u.upcoming ? <span class="size-1.5 rounded-full border border-dashed border-accent" /> : <span class="size-1.5 rounded-full bg-accent" />}
                  {u.date}
                  {u.upcoming && <span class="text-accent">· Next</span>}
                </span>
                <span class="text-sm leading-relaxed text-fg">{u.text}</span>
                {u.href && <Icon name="arrow" size={14} class="hidden text-faint transition-all group-hover:translate-x-0.5 group-hover:text-accent sm:block" />}
              </Tag>
            </li>
          );
        })
      }
    </ol>
  </section>

  <!-- ── EXPLORE (links to the other pages) ───────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" id="explore">
    <SectionHeading index="03" label="Explore" title="More about me" />
    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        explore.map((e, i) => (
          <a href={url(e.href)} class="reveal group relative flex flex-col bg-surface p-6 transition-colors hover:bg-surface-2">
            <span class="font-mono text-[0.68rem] tracking-[0.12em] text-faint uppercase">
              {e.kicker}
            </span>
            <span class="livery mt-6 text-5xl">{e.stat}</span>
            <span class="mt-2 text-xs text-faint">{e.statLabel}</span>
            <span class="display mt-6 text-lg">{e.title}</span>
            <span class="mt-1.5 text-sm leading-relaxed text-muted">{e.text}</span>
            <span class="mt-auto flex items-center gap-2 pt-6 text-xs font-semibold tracking-[0.08em] uppercase">
              {e.cta} <Icon name="arrow" size={14} class="text-accent transition-transform group-hover:translate-x-1" />
            </span>
            <span class="absolute bottom-0 left-0 h-[3px] w-0 bg-accent transition-all duration-500 group-hover:w-full" />
          </a>
        ))
      }
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" id="contact" aria-labelledby="contact-h">
    <div class="reveal bp relative overflow-hidden rounded-xl px-6 py-14 sm:px-12 sm:py-20">
      <p class="flex items-center gap-3 font-mono text-[0.68rem] tracking-[0.12em] uppercase opacity-80">
        <span class="font-medium text-[var(--accent-bright)]">04</span>Contact
      </p>
      <h2 id="contact-h" class="livery relative mt-6 max-w-3xl text-[clamp(2.6rem,7vw,5.5rem)]">
        Want to talk?
      </h2>
      <p class="relative mt-6 max-w-lg opacity-85">
        I'm looking for a Summer 2027 internship in aerospace, propulsion, or research. If you're hiring, have a question about
        something here, or just want to talk rockets, send me an email.
      </p>
      <div class="relative mt-9 flex flex-wrap gap-3">
        <button
          type="button"
          data-copy={site.email}
          class="inline-flex h-12 items-center gap-2 bg-accent px-6 text-sm font-semibold tracking-[0.06em] text-on-accent uppercase transition-transform hover:-translate-y-0.5"
        >
          <Icon name="copy" size={16} /><span data-copy-label>Copy email</span>
        </button>
        <a href={`mailto:${site.email}`} class="inline-flex h-12 items-center gap-2 border border-white/40 px-6 text-sm font-medium transition-colors hover:border-white hover:bg-white/10">
          <Icon name="mail" size={16} />{site.email}
        </a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 border border-white/40 px-6 text-sm font-medium transition-colors hover:border-white hover:bg-white/10">
          <Icon name="linkedin" size={15} />LinkedIn
        </a>
        <a href={url('/contact')} class="inline-flex h-12 items-center gap-2 border border-white/40 px-6 text-sm font-semibold tracking-[0.06em] uppercase transition-colors hover:border-white hover:bg-white/10">
          All contact info <Icon name="arrow" size={15} />
        </a>
      </div>
      <!-- Orbit graphic -->
      <svg class="pointer-events-none absolute -right-20 -bottom-24 hidden h-[26rem] w-[26rem] md:block" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="100" cy="100" r="40" stroke-width="0.8" opacity="0.5" />
        <ellipse cx="100" cy="100" rx="92" ry="34" transform="rotate(-18 100 100)" stroke-dasharray="2 4" opacity="0.6" />
        <ellipse cx="100" cy="100" rx="70" ry="62" transform="rotate(30 100 100)" stroke-width="0.6" opacity="0.35" />
        <g transform="rotate(-18 100 100)">
          <circle r="3" fill="var(--accent-bright)" stroke="none">
            <animateMotion dur="9s" repeatCount="indefinite" path="M8 100 A92 34 0 1 1 192 100 A92 34 0 1 1 8 100" />
          </circle>
        </g>
      </svg>
    </div>
  </section>
</BaseLayout>

<script>
  // Old links like /#experience or /#awards now live on their own pages
  const moved: Record<string, string> = { '#experience': 'resume#experience', '#awards': 'resume#awards', '#skills': 'resume#skills', '#about-me': 'about' };
  const to = moved[location.hash];
  if (to) location.replace(new URL(to, document.baseURI).href);
</script>
