---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, papers } from '../config';
import { url } from '../utils';
---

<BaseLayout title="Papers" description={`Research papers by ${site.name}.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <PageHeader tag="PAPERS" label={`${papers.length} paper${papers.length === 1 ? '' : 's'}`} title="Papers">
      Full write-ups of my research, with methods, data, and analysis. Each one opens as a PDF.
    </PageHeader>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14 pb-6 sm:px-6">
    <ol class="space-y-8">
      {
        papers.map((p, i) => (
          <li class="reveal">
            <article class="card overflow-hidden lg:grid lg:grid-cols-[1fr_340px]">
              <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.68rem] tracking-[0.12em] text-faint uppercase">
                  <span class="bg-accent px-1.5 py-0.5 font-medium text-white">PPR-{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-fg">{p.subject}</span>
                  <span>{p.year}</span>
                  {p.pages && <span>{p.pages} pages</span>}
                  {p.words && <span>{p.words} words</span>}
                </div>
                <h2 class="mt-4 text-2xl leading-snug text-balance hyphens-auto [overflow-wrap:anywhere] sm:text-[1.75rem] sm:hyphens-none">{p.title}</h2>
                <p class="mt-2 text-sm text-muted">{p.authors ?? site.name}</p>

                <h3 class="label mt-6">Abstract</h3>
                <p class="mt-2 leading-relaxed text-muted">{p.abstract}</p>

                <h3 class="label mt-6">{p.findingsLabel ?? 'Key findings'}</h3>
                <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-muted">
                  {p.findings.map((f) => (
                    <li class="relative pl-5">
                      <span class="absolute top-[0.6em] left-0 h-[2px] w-2.5 bg-accent" />
                      {f}
                    </li>
                  ))}
                </ul>

                <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Keywords">
                  {p.keywords.map((k) => <li class="tag">{k}</li>)}
                </ul>

                <div class="mt-7 flex flex-wrap gap-3">
                  <a
                    href={url(p.pdf)}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex h-11 items-center gap-2 bg-fg px-5 text-xs font-semibold tracking-[0.08em] text-bg uppercase transition-colors hover:bg-accent hover:text-white"
                  >
                    <Icon name="file" size={15} /> {p.pdfLabel ?? 'Read the paper (PDF)'}
                  </a>
                  {p.project && (
                    <a
                      href={url(p.project)}
                      class="inline-flex h-11 items-center gap-2 border border-fg px-5 text-xs font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-fg hover:text-bg"
                    >
                      Project write-up <Icon name="arrow" size={15} />
                    </a>
                  )}
                </div>
              </div>

              {p.figure && (
                <a href={url(p.pdf)} target="_blank" rel="noopener" class="group relative hidden border-l border-line bg-white lg:flex lg:items-center lg:p-5" aria-label={`Open ${p.title} (PDF)`}>
                  <img src={url(p.figure)} alt="" loading="lazy" class="w-full transition-transform duration-500 group-hover:scale-[1.03]" />
                  <span class="absolute right-3 bottom-3 font-mono text-[0.6rem] tracking-[0.14em] text-[#5b606a] uppercase">Fig. from paper</span>
                </a>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
