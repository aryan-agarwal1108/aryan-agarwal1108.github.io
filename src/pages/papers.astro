---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, papers } from '../config';
import { url, pad } from '../utils';
---

<BaseLayout title="Papers" description={`Research papers by ${site.name}.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <PageHeader tag="PAPERS" label={`${papers.length} paper${papers.length === 1 ? '' : 's'}`} title="Papers">
      Write-ups of my research, with methods, data, and analysis. Open one for the full details and the PDF.
    </PageHeader>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14 pb-6 sm:px-6">
    <ol class="grid gap-5 md:grid-cols-2">
      {
        papers.map((p, i) => (
          <li class="reveal">
            <a href={url(`/papers/${p.slug}`)} class="card group flex h-full flex-col p-6 sm:p-7">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.68rem] tracking-[0.12em] text-faint uppercase">
                <span class="bg-accent px-1.5 py-0.5 font-medium text-white">PPR-{pad(i + 1)}</span>
                <span class="text-fg">{p.subject}</span>
                <span>{p.year}</span>
              </div>
              <h2 class="mt-4 text-xl leading-snug text-balance hyphens-auto [overflow-wrap:anywhere] transition-colors group-hover:text-accent sm:text-[1.4rem] sm:hyphens-none">
                {p.title}
              </h2>
              <p class="mt-2 text-sm text-faint">{p.authors ?? site.name}</p>
              <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-muted">{p.abstract}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Keywords">
                {p.keywords.slice(0, 4).map((k) => <li class="tag">{k}</li>)}
              </ul>
              <span class="mt-auto flex items-center gap-2 pt-6 text-xs font-semibold tracking-[0.08em] uppercase">
                Read more <Icon name="arrow" size={14} class="text-accent transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
