---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Timeline from '../components/Timeline.astro';
import { site, education, leadership, highlights, now, interests } from '../config';
import { url } from '../utils';

// A short "how I got here" path, built from the resume. Oldest first.
const journey: { when: string; where: string; what: string; next?: boolean }[] = [
  { when: '2023', where: 'Dubai, UAE', what: 'Founded Erudios to connect high schoolers with university research mentors' },
  { when: '2024', where: 'New York, USA', what: 'Selected as 1 of 52 World Science Scholars worldwide' },
  { when: '2024', where: 'Abu Dhabi, UAE', what: 'Youngest intern at the Technology Innovation Institute, working on satellite quantum key distribution' },
  { when: '2025', where: 'Abu Dhabi, UAE', what: 'Research at NYU Abu Dhabi: eVTOL drone design (CAIR Lab) and quantum machine learning (eBRAIN Lab)' },
  { when: '2026', where: 'Dubai, UAE', what: 'Finished the IB Diploma with 40/45 and a thesis on atmospheric light scattering' },
  { when: '2026', where: 'Urbana-Champaign, IL', what: 'Started Aerospace Engineering + Physics at UIUC. Joined ISS Hybrid and Midwest Nice Aerospace Group, and flew my first model rocket in AE 100' },
  { when: '2027', where: 'Urbana-Champaign, IL', what: 'Next: joining the CHESS hypersonics lab in January', next: true },
];
---

<BaseLayout title="About" description={`About ${site.name}: background, education, and what I'm working on now.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="reveal">
        <p class="label flex items-center gap-3"><span class="text-accent">ABOUT</span><span class="h-px w-8 bg-line-strong"></span>Background</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
          Hi, I'm {site.firstName}<span class="text-accent">.</span>
        </h1>
        <div class="prose mt-8 max-w-2xl">
          <p>
            I'm a <strong>dual-degree Aerospace Engineering and Physics</strong> student at the <strong>{site.school}</strong>,
            graduating in {site.gradYear}. I'm drawn to everything space and quantum: where spaceflight propulsion is heading
            next, and how satellites and quantum technology are changing the way we communicate.
          </p>
          <p>
            I finished high school at Dubai International Academy, and alongside the IB Diploma I spent a lot of time in research
            labs. At the <strong>Technology Innovation Institute</strong> I worked on detectors for satellite quantum key
            distribution. At <strong>NYU Abu Dhabi</strong> I designed an eVTOL drone that can survive a water landing, and helped
            build a framework for explaining quantum reinforcement-learning agents.
          </p>
          <p>
            At UIUC I'm modeling blown-wing aerodynamics with the <strong>Midwest Nice Aerospace Group</strong> and building
            fuel-grain manufacturing hardware with the <strong>Illinois Space Society's Hybrid rocket team</strong>. In January
            I'm joining the <strong>Center for Hypersonics and Entry Systems Studies (CHESS)</strong>.
          </p>
          <p>
            Outside my own work, I care about making research accessible. I founded{' '}
            <a href={leadership[0].href} target="_blank" rel="noopener">Erudios</a>, which partnered 200+ university students with
            1,000+ high schoolers around the world and led to 150+ published student papers.
          </p>
        </div>
      </div>

      <aside class="reveal max-w-[320px] space-y-4">
        <div class="corners overflow-hidden rounded-xl border border-line bg-surface">
          <div class="blueprint-fill grid aspect-square place-items-center">
            <!-- Replace with: <img src={url('/images/headshot.jpg')} alt="Aryan Agarwal" class="size-full object-cover" /> -->
            <span class="font-mono text-6xl font-medium tracking-tight text-accent/80">{site.initials}</span>
          </div>
          <div class="space-y-1.5 border-t border-line px-4 py-3 text-sm text-muted">
            <p class="flex items-center gap-2"><Icon name="pin" size={15} />{site.location}</p>
            <p class="pl-[23px] text-faint">Previously {site.previously}</p>
          </div>
        </div>
        <a href={url('/resume')} class="card flex items-center justify-between px-4 py-3.5 text-sm">
          <span class="flex items-center gap-2.5"><Icon name="file" size={16} />View resume</span>
          <Icon name="arrow" size={15} class="text-faint" />
        </a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="card flex items-center justify-between px-4 py-3.5 text-sm">
          <span class="flex items-center gap-2.5"><Icon name="linkedin" size={15} />Connect on LinkedIn</span>
          <Icon name="external" size={15} class="text-faint" />
        </a>
      </aside>
    </div>

    <!-- Highlights -->
    <dl class="reveal mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4">
      {
        highlights.map((h) => (
          <div class="bg-surface p-5 sm:p-6">
            <dd class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{h.value}</dd>
            <dt class="mt-1.5 text-xs leading-snug text-faint">{h.label}</dt>
          </div>
        ))
      }
    </dl>

    <!-- Journey -->
    <div class="mt-20">
      <p class="reveal label flex items-center gap-3"><span class="text-accent">01</span><span class="h-px w-8 bg-line-strong"></span>Flight path</p>
      <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">How I got here</h2>
      <ol class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          journey.map((j, i) => (
            <li class:list={['reveal relative p-6', j.next ? 'blueprint-fill' : 'bg-surface']}>
              <div class="flex items-center justify-between font-mono text-[0.68rem] tracking-wider text-faint uppercase">
                <span><span class="text-accent">{j.next ? 'NEXT' : `WP-${String(i + 1).padStart(2, '0')}`}</span> · {j.when}</span>
                <span>{j.where}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-fg">{j.what}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Education + Now -->
    <div class="mt-20 grid gap-5 lg:grid-cols-[1.4fr_1fr]">
      <div class="reveal card p-6 sm:p-8">
        <h2 class="label mb-6">Education</h2>
        <div class="space-y-6">
          {
            education.map((e) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="font-medium text-fg">{e.school}</p>
                  <p class="font-mono text-xs text-faint uppercase">{e.date}</p>
                </div>
                <p class="mt-1 text-sm text-muted">{e.degree}</p>
                {e.details?.map((d) => <p class="mt-2 text-sm text-muted italic">{d}</p>)}
              </div>
            ))
          }
        </div>
      </div>
      <div class="reveal card p-6 sm:p-8">
        <h2 class="label mb-6 flex items-center gap-2"><span class="pulse-dot"></span>Currently</h2>
        <ul class="space-y-3 text-sm text-muted">
          {now.map((n) => <li class="relative pl-5"><span class="absolute left-0 font-mono text-accent">→</span>{n}</li>)}
        </ul>
      </div>
    </div>

    <!-- Leadership -->
    <div class="mt-20">
      <p class="reveal label flex items-center gap-3"><span class="text-accent">02</span><span class="h-px w-8 bg-line-strong"></span>Leadership & activities</p>
      <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">Outside the lab</h2>
      <Timeline items={leadership} compact />
    </div>

    {
      interests.length > 0 && (
        <div class="mt-20">
          <p class="reveal label flex items-center gap-3"><span class="text-accent">03</span><span class="h-px w-8 bg-line-strong" />Off the clock</p>
          <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">Beyond engineering</h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {interests.map((it) => (
              <div class="reveal card p-6">
                <h3 class="font-medium text-fg">{it.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
