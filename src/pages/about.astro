---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, education, leadership, highlights, now, interests, languages } from '../config';
import { url } from '../utils';

// A short "how I got here" path, built from the resume. Oldest first.
const journey: { when: string; where: string; what: string; next?: boolean }[] = [
  { when: '2023', where: 'Dubai, UAE', what: 'Started Erudios, a free research-mentorship program for high schoolers' },
  { when: '2024', where: 'New York, USA', what: 'Picked as one of 52 World Science Scholars' },
  { when: '2024', where: 'Abu Dhabi, UAE', what: 'Summer at TII as its youngest quantum researcher: SNSPD optics and polarization-based QKD' },
  { when: '2025', where: 'Abu Dhabi, UAE', what: 'Research at NYU Abu Dhabi: an eVTOL drone at CAIR and quantum RL at eBRAIN' },
  { when: '2026', where: 'Dubai, UAE', what: 'Finished the IB Diploma (40/45), with a research paper on how temperature affects light depolarization' },
  { when: '2026', where: 'Urbana-Champaign, IL', what: 'Moved to UIUC. Joined ISS Hybrid and Midwest Nice, and built and flew a rocket in AE 100' },
  { when: '2027', where: 'Urbana-Champaign, IL', what: 'Starting hypersonics research at CHESS in January', next: true },
];
---

<BaseLayout
  sections={[
    { id: 'journey', label: 'How I got here' },
    { id: 'education', label: 'Education & now' },
    ...(interests.length > 0 || languages.length > 0 ? [{ id: 'beyond', label: 'Beyond engineering' }] : []),
  ]}
  title="About" description={`About ${site.name}: background, education, and what I'm working on now.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20" id="background">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div>
        <p class="hero-in flex items-center gap-3">
          <span class="label">Background</span>
        </p>
        <h1 class="livery mt-6 text-[clamp(2.6rem,8vw,6rem)]">
          <span class="rise"><span>Hi, I'm</span></span>
          <span class="rise"><span style="--d:0.1s">{site.firstName}</span></span>
        </h1>
        <div class="ruler hero-in mt-8" style="--d:0.25s"></div>
        <div class="prose hero-in mt-8 max-w-2xl" style="--d:0.3s">
          <p>
            I'm a first-year at the <strong>University of Illinois</strong>, doing a dual degree in{' '}
            <strong>Aerospace Engineering and Physics</strong> (class of {site.gradYear}). Space and quantum physics are the two
            things I keep coming back to, especially where rocket propulsion is headed and how satellites will carry
            quantum-secure communication.
          </p>
          <p>
            I finished high school at Dubai International Academy. Alongside the IB, I spent most of my free time in labs. At the{' '}
            <strong>Technology Innovation Institute</strong> I did optics work for a superconducting nanowire single-photon detector
            and researched polarization-based quantum key distribution for the UAE's quantum optical ground station. At <strong>NYU Abu Dhabi</strong> I designed an eVTOL drone with an inflatable
            flotation system, and worked on ways to explain what quantum reinforcement-learning agents are actually doing.
          </p>
          <p>
            Since getting to UIUC I've joined the Hybrid team at the <strong>Illinois Space Society</strong>, where I'm designing
            parts for a fuel-grain spin-caster, and I'm modeling a blown-wing PA-28 with the{' '}
            <strong>Midwest Nice Aerospace Group</strong> under Dr. Elle Wroblewski. In January I start research at <strong>CHESS</strong>, the university's
            hypersonics center.
          </p>
          <p>
            Outside engineering, I started{' '}
            <a href={leadership[0].href} target="_blank" rel="noopener">Erudios</a>, a free research-mentorship program that
            ended up connecting 1,000+ high schoolers with university mentors.
          </p>
        </div>
      </div>

      <aside class="reveal max-w-[320px] space-y-4">
        <div class="corners overflow-hidden rounded-xl border border-line bg-surface">
          <div class="blueprint-fill grid aspect-square place-items-center">
            <!-- Replace with: <img src={url('/images/headshot.jpg')} alt="Aryan Agarwal" class="size-full object-cover" /> -->
            <span class="font-mono text-6xl font-medium tracking-tight text-accent/80">{site.initials}</span>
          </div>
          <div class="space-y-1.5 border-t border-line px-4 py-3 text-sm text-muted">
            <p class="flex items-center gap-2"><Icon name="pin" size={15} />{site.location}</p>
            <p class="pl-[23px] text-faint">Previously {site.previously}</p>
          </div>
        </div>
        <a href={url('/resume')} class="card flex items-center justify-between px-4 py-3.5 text-sm">
          <span class="flex items-center gap-2.5"><Icon name="file" size={16} />View resume</span>
          <Icon name="arrow" size={15} class="text-faint" />
        </a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="card flex items-center justify-between px-4 py-3.5 text-sm">
          <span class="flex items-center gap-2.5"><Icon name="linkedin" size={15} />Connect on LinkedIn</span>
          <Icon name="external" size={15} class="text-faint" />
        </a>
      </aside>
    </div>

    <!-- Highlights -->
    <dl id="highlights" class="reveal mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4">
      {
        highlights.map((h) => (
          <div class="bg-surface p-5 sm:p-6">
            <dd class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{h.value}</dd>
            <dt class="mt-1.5 text-xs leading-snug text-faint">{h.label}</dt>
          </div>
        ))
      }
    </dl>

    <!-- Journey -->
    <div class="mt-20" id="journey">
      <p class="reveal label flex items-center gap-3"><span class="text-accent">01</span><span class="h-px w-8 bg-line-strong"></span>Flight path</p>
      <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">How I got here</h2>
      <ol class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          journey.map((j, i) => (
            <li class:list={['reveal relative p-6', j.next ? 'blueprint-fill' : 'bg-surface']}>
              <div class="flex items-center justify-between font-mono text-[0.68rem] tracking-wider text-faint uppercase">
                <span>{j.next ? <span class="text-accent">Next · {j.when}</span> : j.when}</span>
                <span>{j.where}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-fg">{j.what}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Education + Now -->
    <div class="mt-20" id="education">
      <p class="reveal label flex items-center gap-3"><span class="text-accent">02</span><span class="h-px w-8 bg-line-strong"></span>Education & now</p>
      <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">Where I am now</h2>
    <div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
      <div class="reveal card p-6 sm:p-8">
        <h3 class="label mb-6">Education</h3>
        <div class="space-y-6">
          {
            education.map((e) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="font-medium text-fg">{e.school}</p>
                  <p class="font-mono text-xs text-faint uppercase">{e.date}</p>
                </div>
                <p class="mt-1 text-sm text-muted">{e.degree}</p>
                {e.subjects && (
                  <div class="mt-3">
                    <p class="font-mono text-[0.65rem] tracking-[0.12em] text-faint uppercase">Higher Level subjects</p>
                    <ul class="mt-2 flex flex-wrap gap-1.5">
                      {e.subjects.map((sub) => <li class="tag">{sub}</li>)}
                    </ul>
                  </div>
                )}
                {e.details?.map((d) => <p class="mt-2 text-sm text-muted italic">{d}</p>)}
              </div>
            ))
          }
        </div>
      </div>
      <div class="reveal card p-6 sm:p-8">
        <h3 class="label mb-6 flex items-center gap-2"><span class="pulse-dot"></span>Currently</h3>
        <ul class="space-y-3 text-sm text-muted">
          {now.map((n) => <li class="relative pl-5"><span class="absolute left-0 font-mono text-accent">→</span>{n}</li>)}
        </ul>
      </div>
    </div>

    </div>

    {
      (interests.length > 0 || languages.length > 0) && (
        <div class="mt-20" id="beyond">
          <p class="reveal label flex items-center gap-3"><span class="text-accent">03</span><span class="h-px w-8 bg-line-strong" />Off the clock</p>
          <h2 class="reveal mt-3 mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">Beyond engineering</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {interests.map((it) => (
              <div class="reveal card p-6">
                <h3 class="font-medium text-fg">{it.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{it.text}</p>
              </div>
            ))}
            {languages.length > 0 && (
              <div class="reveal card p-6">
                <h3 class="font-medium text-fg">Languages</h3>
                <ul class="mt-3 space-y-2.5 text-sm">
                  {languages.map((l) => {
                    const steps = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2', 'Native'];
                    const n = steps.indexOf(l.level) + 1;
                    return (
                      <li class="grid grid-cols-[5.5rem_1fr_auto] items-center gap-3">
                        <span class="text-fg">{l.name}</span>
                        <span class="flex gap-[3px]" aria-hidden="true">
                          {steps.map((_, k) => (
                            <span class:list={['h-1.5 flex-1', k < n ? 'bg-accent' : 'bg-line']} />
                          ))}
                        </span>
                        <span class="w-12 text-right font-mono text-[0.7rem] tracking-wider text-muted uppercase">{l.level}</span>
                      </li>
                    );
                  })}
                </ul>
                <p class="mt-4 font-mono text-[0.62rem] tracking-[0.1em] text-faint uppercase">Levels on the CEFR scale (A1–C2)</p>
              </div>
            )}
          </div>
        </div>
      )
    }

    <div class="reveal mt-16 flex flex-wrap gap-3">
      <a href={url('/resume#leadership')} class="inline-flex h-10 items-center gap-2 rounded-lg border border-line px-4 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg">
        Leadership & activities <Icon name="arrow" size={15} />
      </a>
      <a href={url('/resume#awards')} class="inline-flex h-10 items-center gap-2 rounded-lg border border-line px-4 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg">
        Awards <Icon name="arrow" size={15} />
      </a>
    </div>
  </section>
</BaseLayout>
