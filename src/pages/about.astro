---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, coursework } from '../config';
import { url } from '../utils';

const now = [
  'Building a low-power LoRa weather station for the lab roof',
  'Learning Rust for embedded targets (embassy-rs)',
  'Reading “The Art of Electronics” one chapter a week',
];
---

<BaseLayout title="About" description={`About ${site.name}: background, education, and what I'm working on now.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_340px]">
      <div class="reveal">
        <p class="label flex items-center gap-3"><span class="text-accent">ABOUT</span><span class="h-px w-8 bg-line-strong"></span>Background</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
          Hi, I'm {site.name.split(' ')[0]}<span class="text-accent">.</span>
        </h1>
        <div class="prose mt-8 max-w-2xl">
          <p>
            I'm a <strong>{site.major}</strong> student at <strong>{site.school}</strong>, graduating in {site.gradYear}. I like
            problems that cross the line between hardware and software, where a design decision in firmware changes what the
            PCB has to look like, and the other way round.
          </p>
          <p>
            I got into engineering by taking apart (and occasionally reassembling) everything in my parents' garage. These
            days I spend most of my time on project teams and in the lab, where I've learned that most of engineering is
            writing down what you tried and why it didn't work.
          </p>
          <p>
            I'm currently looking for <strong>Summer 2027 internships</strong> in embedded systems, hardware, or
            systems software. I care about well-tested code, clear documentation, and teams that ship.
          </p>
          <p class="text-faint italic">(Placeholder bio. Replace this with your own story in <code>src/pages/about.astro</code>.)</p>
        </div>
      </div>

      <aside class="reveal space-y-5">
        <div class="corners overflow-hidden rounded-xl border border-line bg-surface">
          <div class="blueprint-fill grid aspect-square place-items-center">
            <!-- Replace with: <img src="/images/headshot.jpg" alt="Headshot of ..." class="size-full object-cover" /> -->
            <span class="font-mono text-5xl font-medium tracking-tight text-accent/80">{site.initials}</span>
          </div>
          <div class="flex items-center gap-2 border-t border-line px-4 py-3 text-sm text-muted">
            <Icon name="pin" size={15} />{site.location}
          </div>
        </div>
        <a href={url('/resume')} class="card flex items-center justify-between px-4 py-3.5 text-sm">
          <span class="flex items-center gap-2.5"><Icon name="file" size={16} />View resume</span>
          <Icon name="arrow" size={15} class="text-faint" />
        </a>
      </aside>
    </div>

    <div class="mt-20 grid gap-5 md:grid-cols-3">
      <div class="reveal card p-6">
        <h2 class="label mb-4">Education</h2>
        <p class="font-medium text-fg">{site.school}</p>
        <p class="mt-1 text-sm text-muted">B.S. {site.major}</p>
        <p class="mt-3 font-mono text-xs text-faint">EXPECTED MAY {site.gradYear}</p>
      </div>
      <div class="reveal card p-6">
        <h2 class="label mb-4">Relevant coursework</h2>
        <ul class="flex flex-wrap gap-1.5">{coursework.map((c) => <li class="tag">{c}</li>)}</ul>
      </div>
      <div class="reveal card p-6">
        <h2 class="label mb-4 flex items-center gap-2"><span class="pulse-dot"></span>Currently</h2>
        <ul class="space-y-2.5 text-sm text-muted">
          {now.map((n) => <li class="relative pl-5"><span class="absolute left-0 font-mono text-accent">→</span>{n}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
