---
import { getProjects, byRecent } from '../../lib/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { filterSkills } from '../../config';

const projects = await getProjects(); // Recommended order (default)
const recentIds = [...projects].sort(byRecent).map((p) => p.id);
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];

// The dropdown lists general skill areas (see filterSkills in config), with project counts
const groupKeys = (tags: string[]) => {
  const lower = new Set(tags.map((t) => t.toLowerCase()));
  return filterSkills.filter((g) => g.tags.some((t) => lower.has(t.toLowerCase()))).map((g) => g.key);
};
const tools = filterSkills
  .map((g) => [g.key, g.label, projects.filter((p) => groupKeys(p.data.tags).includes(g.key)).length] as [string, string, number])
  .filter(([, , n]) => n > 0);
// Every tag (any case) → its display name, so deep links to other tools still work
const allTags = Object.fromEntries(projects.flatMap((p) => p.data.tags.map((t) => [t.toLowerCase(), t])));
---

<BaseLayout title="Projects" description="Aerospace, propulsion, design, and quantum physics projects by Aryan Agarwal.">
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <PageHeader tag="INDEX" label={`${projects.length} projects`} title="Projects">
      Research, club, and class work. Each page covers what the project was for, what my part was, and the tools I used.
    </PageHeader>

    <div class="reveal mt-12 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by discipline">
        {
          categories.map((c, i) => (
            <button
              type="button"
              data-filter={c}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-line-strong hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-fg"
            >
              {c}
              <span class="ml-1 text-faint">
                {c === 'All' ? projects.length : projects.filter((p) => p.data.category === c).length}
              </span>
            </button>
          ))
        }
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex lg:items-center">
        <label class="flex items-center gap-2 font-mono text-xs text-faint">
          <span class="w-9 shrink-0 tracking-wider uppercase">Sort</span>
          <select
            id="sort"
            class="h-10 w-full rounded-md border border-line bg-surface px-2 text-xs text-fg outline-none hover:border-line-strong focus-visible:border-accent lg:h-8 lg:w-44"
          >
            <option value="recommended">Recommended</option>
            <option value="recent">Most recent</option>
          </select>
        </label>
        <label class="flex items-center gap-2 font-mono text-xs text-faint">
          <span class="w-9 shrink-0 tracking-wider uppercase">Skill</span>
          <select
            id="tool"
            class="h-10 w-full rounded-md border border-line bg-surface px-2 text-xs text-fg outline-none hover:border-line-strong focus-visible:border-accent lg:h-8 lg:w-52"
          >
            <option value="">Any skill</option>
            {tools.map(([key, label, n]) => <option value={'skill:' + key}>{label} ({n})</option>)}
          </select>
        </label>
      </div>
    </div>

    <p id="status" class="mt-5 font-mono text-xs text-faint" aria-live="polite"></p>

    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="grid" data-all-tags={JSON.stringify(allTags)}>
      {projects.map((p, i) => <ProjectCard project={p} index={i} recent={recentIds.indexOf(p.id)} skills={groupKeys(p.data.tags)} />)}
    </div>
    <p id="empty" class="hidden py-16 text-center text-muted">No projects match that combination.</p>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const select = document.getElementById('tool') as HTMLSelectElement;
  const sortSel = document.getElementById('sort') as HTMLSelectElement;
  const grid = document.getElementById('grid')!;
  const cards = document.querySelectorAll<HTMLElement>('#grid [data-category]');

  function sortCards(updateUrl = true) {
    const key = sortSel.value === 'recent' ? 'recent' : 'rec';
    [...cards]
      .sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]))
      .forEach((c) => grid.appendChild(c));
    if (updateUrl) {
      const u = new URL(location.href);
      sortSel.value === 'recent' ? u.searchParams.set('sort', 'recent') : u.searchParams.delete('sort');
      history.replaceState(null, '', u);
    }
  }
  sortSel.addEventListener('change', () => sortCards());
  if (new URLSearchParams(location.search).get('sort') === 'recent') {
    sortSel.value = 'recent';
    sortCards(false);
  }
  const status = document.getElementById('status')!;
  const empty = document.getElementById('empty')!;
  let category = 'All';

  function apply(updateUrl = true) {
    const tool = select.value;
    let shown = 0;
    cards.forEach((c) => {
      const ok =
        (category === 'All' || c.dataset.category === category) &&
        (!tool || (tool.startsWith('skill:') ? (c.dataset.skills ?? '').split('|').includes(tool.slice(6)) : (c.dataset.tags ?? '').split('|').includes(tool)));
      c.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    empty.classList.toggle('hidden', shown > 0);
    const label = select.selectedOptions[0]?.textContent?.replace(/\s*\(\d+\)$/, '');
    status.textContent =
      category === 'All' && !tool
        ? ''
        : `Showing ${shown} project${shown === 1 ? '' : 's'}${category !== 'All' ? ` in ${category}` : ''}${tool ? ` using ${label}` : ''}`;
    if (updateUrl) {
      const u = new URL(location.href);
      tool ? u.searchParams.set('tool', tool) : u.searchParams.delete('tool');
      category !== 'All' ? u.searchParams.set('discipline', category) : u.searchParams.delete('discipline');
      history.replaceState(null, '', u);
    }
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      category = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply();
    }),
  );
  select.addEventListener('change', () => apply());

  // Deep links: /projects?tool=solidworks or ?discipline=Quantum
  const params = new URLSearchParams(location.search);
  const t = params.get('tool')?.toLowerCase();
  if (t && ![...select.options].some((o) => o.value === t)) {
    // A link to a tool outside the short list (e.g. from a skill chip): add it for this visit
    const name = JSON.parse(grid.dataset.allTags ?? '{}')[t];
    if (name) select.add(new Option(`${name} (${[...cards].filter((c) => (c.dataset.tags ?? '').split('|').includes(t)).length})`, t));
  }
  if (t && [...select.options].some((o) => o.value === t)) select.value = t;
  const d = params.get('discipline');
  const match = [...buttons].find((b) => b.dataset.filter === d);
  if (match) {
    category = d!;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === match)));
  }
  if (t || d) apply(false);
</script>
