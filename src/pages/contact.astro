---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';

const c = site.contact;

// Encode contact strings so they don't appear as plain text in the HTML.
// The browser decodes them on load (see script below).
const enc = (s: string) => Buffer.from([...s].reverse().join(''), 'utf8').toString('base64');
const human = (email: string) => email.replace('@', ' [at] ').replace(/\.(?=[^.]+$)/, ' [dot] ');

const channels = [
  { ch: '01', label: 'Personal email', kind: 'mail', value: c.personalEmail, fallback: human(c.personalEmail), note: 'Best for anything' },
  { ch: '02', label: 'School email', kind: 'mail', value: c.schoolEmail, fallback: human(c.schoolEmail), note: 'UIUC' },
  { ch: '03', label: 'Phone', kind: 'tel', value: c.phone, href: c.phoneHref, fallback: 'Enable JavaScript to see it', note: 'Call or text' },
  { ch: '04', label: 'LinkedIn', kind: 'link', value: site.links.linkedin.replace('https://www.', ''), href: site.links.linkedin, note: 'Connect' },
];

// Research areas I'm looking for internships and research positions in
const interests = [
  { area: 'Hypersonics & atmospheric entry', text: 'High-speed aerothermodynamics and entry systems, the focus of my upcoming research at CHESS.' },
  { area: 'Aerodynamics & CFD', text: 'Low-speed and powered-lift aerodynamics, blown wings, and computational fluid dynamics.' },
  { area: 'Rocket propulsion', text: 'Hybrid and solid rocket propulsion, from fuel-grain manufacturing to flight performance.' },
  { area: 'Aircraft & UAV design', text: 'Conceptual design, structures, and emergency systems for aircraft and eVTOL drones.' },
  { area: 'Space systems', text: 'Spacecraft and satellite systems, including optical ground stations and satellite links.' },
  { area: 'Quantum optics & communication', text: 'Single-photon detection, free-space optics, and satellite quantum key distribution.' },
];
---

<BaseLayout
  sections={[
    { id: 'channels', label: 'Reach me' },
    { id: 'research-interests', label: 'Research interests' },
  ]}
  title="Contact" description={`Get in touch with ${site.name}: email, phone, and LinkedIn.`}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-20">
    <PageHeader tag="COMMS" label="Get in touch" title="Contact">
      The fastest way to reach me is email. I'm open to Summer 2027 internships in aerospace, propulsion, and research.
    </PageHeader>
    <p class="hero-in mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted" style="--d:0.35s">
      <Icon name="pin" size={15} class="text-accent" />
      Based in {c.current.city} · Home in {c.home.city}, {c.home.country}
    </p>
  </section>

  <!-- ── Comms channels ────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-6 sm:px-6" id="channels">
    <SectionHeading index="01" label="Comms channels" title="Reach me directly" />
    <ul class="grid gap-5 sm:grid-cols-2">
      {
        channels.map((ch) => (
          <li class="reveal card group relative flex flex-col p-6">
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2 font-mono text-[0.68rem] tracking-[0.14em] uppercase">
                <span class="grid h-6 min-w-9 place-items-center bg-fg px-1.5 text-bg">CH {ch.ch}</span>
                <span class="text-faint">{ch.note}</span>
              </span>
              <span class="text-accent">
                <Icon name={ch.kind === 'mail' ? 'mail' : ch.kind === 'tel' ? 'phone' : 'linkedin'} size={18} />
              </span>
            </div>
            <p class="label mt-6">{ch.label}</p>
            {ch.kind === 'link' ? (
              <p class="display mt-1 text-xl break-all sm:text-2xl">{ch.value}</p>
            ) : (
              <p class="display mt-1 text-xl break-all sm:text-2xl" data-reveal={enc(ch.value)}>{ch.fallback}</p>
            )}
            <div class="mt-6 flex flex-wrap gap-2">
              {ch.kind === 'link' ? (
                <a href={ch.href} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 bg-fg px-4 text-xs font-semibold tracking-[0.08em] text-bg uppercase transition-colors hover:bg-accent hover:text-white">
                  Open profile <Icon name="external" size={14} />
                </a>
              ) : (
                <>
                  <a
                    href="#"
                    data-action-href={enc(ch.kind === 'mail' ? `mailto:${ch.value}` : `tel:${ch.href}`)}
                    class="inline-flex h-10 items-center gap-2 bg-fg px-4 text-xs font-semibold tracking-[0.08em] text-bg uppercase transition-colors hover:bg-accent hover:text-white"
                  >
                    {ch.kind === 'mail' ? 'Send email' : 'Call'} <Icon name="arrow" size={14} />
                  </a>
                  <button
                    type="button"
                    data-copy-enc={enc(ch.value)}
                    class="inline-flex h-10 items-center gap-2 border border-fg px-4 text-xs font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-fg hover:text-bg"
                  >
                    <Icon name="copy" size={14} /><span data-copy-label>Copy</span>
                  </button>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── Research interests ────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-6 sm:px-6" id="research-interests">
    <SectionHeading index="02" label="Research interests" title="What I want to work on" />
    <ul class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        interests.map((r, i) => (
          <li class="reveal bg-surface p-6">
            <span class="font-mono text-[0.68rem] tracking-[0.12em] text-accent">RI-{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display mt-3 text-lg">{r.area}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{r.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

</BaseLayout>

<script>
  import { scramble } from '../scripts/motion';

  const dec = (s: string) => [...new TextDecoder().decode(Uint8Array.from(atob(s), (ch) => ch.charCodeAt(0)))].reverse().join('');

  // Reveal obfuscated contact details
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => {
    const value = dec(el.dataset.reveal!);
    el.textContent = value;
    setTimeout(() => scramble(el, value, 700), 200 + i * 120);
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-action-href]').forEach((a) => {
    a.href = dec(a.dataset.actionHref!);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy-enc]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(dec(btn.dataset.copyEnc!));
        scramble(label, 'COPIED', 350);
        setTimeout(() => scramble(label, 'COPY', 350), 1500);
      } catch {}
    });
  });

</script>
